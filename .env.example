# =============================================================================
# Timelly ERP — environment template
# Copy to .env and fill in values:  cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Supabase Storage (file uploads) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Auth (NextAuth) ---
# Must be the exact URL users open in browser / mobile WebView.
# Local web + iOS simulator:  http://localhost:3000
# Android emulator:           http://10.0.2.2:3000
# Production:                 https://your-production-domain.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret

# --- Capacitor mobile app (Android / iOS) ---
# URL the native WebView loads. Run `npm run cap:sync` after changing.
# Should match NEXTAUTH_URL in production.
# iOS simulator / local web:  http://localhost:3000
# Android emulator:           http://10.0.2.2:3000
# Physical device (same Wi‑Fi): http://192.168.x.x:3000
# Production:                 https://your-production-domain.com
CAPACITOR_SERVER_URL=http://localhost:3000

# --- Redis cache (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=true
REDIS_TIMEOUT_MS=120
REDIS_COOLDOWN_MS=30000
REDIS_VERSION_SYNC_MS=2000

# --- Prisma / query cache (optional tuning) ---
PRISMA_CONNECTION_LIMIT=15
PRISMA_SLOW_QUERY_MS=50
LOCAL_QUERY_CACHE_ENABLED=true
LOCAL_QUERY_CACHE_TTL_MS=45000

# --- HyperPG payments (optional — can also be set per school in admin UI) ---
HYPERPG_BASE_URL=https://sandbox.hyperpg.in
HYPERPG_MERCHANT_ID=
HYPERPG_API_KEY=
HYPERPG_CLIENT_ID=test
HYPERPG_AUTH_STYLE=api_key
HYPERPG_RETURN_URL=
HYPERPG_LINK_EXPIRY_MINS=
HYPERPG_USE_GLOBAL_CREDENTIALS=false
HYPERPG_USE_SANDBOX_PLACEHOLDER_RETURN=0
HYPERPG_WEBHOOK_USERNAME=
HYPERPG_WEBHOOK_PASSWORD=
HYPERPG_WEBHOOK_HEADER_NAME=
HYPERPG_WEBHOOK_HEADER_VALUE=

# --- Parent subscription (optional) ---
PARENT_SUBSCRIPTION_AMOUNT_DEFAULT=
PARENT_SUBSCRIPTION_TRIAL_DAYS_DEFAULT=
PARENT_SUBSCRIPTION_DAYS=30
