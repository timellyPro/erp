# Copy to .env (local) or set in the hosting dashboard (production).
# Never commit real values. "REQUIRED" = /api/health reports unhealthy in production without it.

# --- Database (Postgres via Supabase PgBouncer) ---
# REQUIRED. Owner connection, pooled (:6543, pgbouncer=true).
DATABASE_URL=
# Unpooled (:5432). Used for migrations and as fallback for DATABASE_URL.
DIRECT_URL=
# REQUIRED. Restricted app_tenant role used by RLS-scoped routes (docs/SECURITY_REVIEW.md section 3).
DATABASE_URL_TENANT=
# Optional tuning
PRISMA_CONNECTION_LIMIT=
PRISMA_SLOW_QUERY_MS=
PRISMA_READ_RETRY_COUNT=
PRISMA_READ_RETRY_DELAY_MS=
TENANT_SCOPE_TIMEOUT_MS=
TENANT_SCOPE_RETRY_COUNT=
TENANT_SCOPE_RETRY_DELAY_MS=

# --- Auth ---
# REQUIRED. Long random string (openssl rand -base64 32).
NEXTAUTH_SECRET=
# REQUIRED. Deployed origin; must be https:// in production.
NEXTAUTH_URL=http://localhost:3000
# Optional dedicated secret for internal calls (falls back to NEXTAUTH_SECRET).
INTERNAL_API_SECRET=

# --- Scheduled jobs ---
# REQUIRED. Vercel Cron sends this as "Authorization: Bearer <value>".
CRON_SECRET=

# --- Redis cache / rate limiting (Upstash). Optional: app falls back to in-memory. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=true
REDIS_TIMEOUT_MS=120
REDIS_COOLDOWN_MS=30000
REDIS_VERSION_SYNC_MS=2000
LOCAL_QUERY_CACHE_ENABLED=
LOCAL_QUERY_CACHE_TTL_MS=

# --- File storage (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
NEXT_PUBLIC_SUPABASE_URL=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Payments (HyperPG) ---
HYPERPG_BASE_URL=
HYPERPG_MERCHANT_ID=
HYPERPG_API_KEY=
HYPERPG_CLIENT_ID=
HYPERPG_AUTH_STYLE=
HYPERPG_USE_GLOBAL_CREDENTIALS=
HYPERPG_RETURN_URL=
HYPERPG_LINK_EXPIRY_MINS=
HYPERPG_WEBHOOK_USERNAME=
HYPERPG_WEBHOOK_PASSWORD=
HYPERPG_WEBHOOK_HEADER_NAME=
HYPERPG_WEBHOOK_HEADER_VALUE=

# --- Parent subscription defaults ---
PARENT_SUBSCRIPTION_TRIAL_DAYS_DEFAULT=
PARENT_SUBSCRIPTION_AMOUNT_DEFAULT=

# --- Socket server (separate process, socket-server/index.ts) ---
SOCKET_PORT=3001
# Origin of the web app allowed to connect (falls back to NEXTAUTH_URL).
SOCKET_CORS_ORIGIN=
